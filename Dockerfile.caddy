# Caddy with the rate-limit module compiled in.
#
# The Caddyfile uses the `rate_limit` directive to protect the authentication
# and Meilisearch routes. Rate limiting is NOT part of Caddy's core: the stock
# caddy:2-alpine image rejects the directive as unrecognized and refuses to
# start, so the edge proxy must be built with the module included.
#
# Image Pinning Policy (see docker-compose.prod.yml):
# Both stages are pinned to an immutable SHA256 digest and the module is pinned
# to a released version so the proxy build stays reproducible.

FROM caddy:2-builder-alpine@sha256:8e89605351333ad2cc2f3bcc95275a2ccc427f88914050e86a5fde0fd77a63c4 AS builder

RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@v0.1.0

FROM caddy:2-alpine@sha256:86deaf5e3d3408a6ccec08fbb79989783dd26e206ae10bcf78a801dc8c9ab794

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
