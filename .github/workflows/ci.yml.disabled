name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

# Bun version is pinned here, in package.json engines, and in the Dockerfiles
# (oven/bun:1.3.13) so CI, local development, and production builds all agree.
env:
  BUN_VERSION: '1.3.13'

jobs:
  lint-and-test:
    name: Lint & Test
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
        with:
          bun-version: ${{ env.BUN_VERSION }}

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Compile i18n messages
        run: bun run i18n:compile

      - name: Lint
        run: bun run lint

      - name: Test
        run: bun run test

  prometheus-rules:
    name: Prometheus Rules
    runs-on: ubuntu-latest
    needs: lint-and-test
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Check Prometheus rules
        run: |
          docker run --rm -v "$PWD/infra/observability/prometheus/rules:/rules:ro" \
            --entrypoint promtool \
            prom/prometheus:v2.55.0 \
            check rules \
            /rules/app-health.yml \
            /rules/backup-failure.yml \
            /rules/checkout-failures.yml \
            /rules/database-connectivity.yml \
            /rules/dependency-health.yml \
            /rules/disk-space.yml \
            /rules/email-alerts.yml \
            /rules/job-errors.yml \
            /rules/meilisearch-health.yml \
            /rules/payment-webhook-errors.yml \
            /rules/payout-stale-pending.yml

  dockerfile-prod:
    name: Production Dockerfile
    runs-on: ubuntu-latest
    needs: lint-and-test
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Build production image
        run: docker build -f Dockerfile.prod -t eurtisan-app:ci .

  ansible-syntax:
    name: Ansible Syntax
    runs-on: ubuntu-latest
    needs: lint-and-test
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Setup Python
        uses: actions/setup-python@8d20150f024dcaa6f3b7bc2eb2ff0fedc8e5a510 # v5
        with:
          python-version: '3.12'

      - name: Install Ansible
        run: pip install ansible

      - name: Syntax-check playbook
        run: ansible-playbook -i infrastructure/ansible/inventory/staging.example.yml infrastructure/ansible/playbook.yml --syntax-check

  check:
    name: Type Check
    runs-on: ubuntu-latest
    needs: lint-and-test
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
        with:
          bun-version: ${{ env.BUN_VERSION }}

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Compile i18n messages
        run: bun run i18n:compile

      - name: Type check
        run: bun run check

  build:
    name: Production Build
    runs-on: ubuntu-latest
    needs: check
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
        with:
          bun-version: ${{ env.BUN_VERSION }}

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Compile i18n messages
        run: bun run i18n:compile

      # Build runs inside Docker to match the production image and verify the
      # Dockerfile still produces a working application.
      - name: Build production app
        run: make build

      - name: Validate deploy script
        run: bash -n infrastructure/ansible/files/deploy.sh

      - name: Validate backup script template syntax
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import re
          content = Path('infrastructure/ansible/roles/eurtisan/templates/backup.sh.j2').read_text()
          rendered = re.sub(r'\{\{[^}]+\}\}', "''", content)
          rendered = re.sub(r'\{%[^%]+%\}', '', rendered)
          Path('/tmp/backup-rendered.sh').write_text(rendered)
          PY
          bash -n /tmp/backup-rendered.sh

  e2e:
    name: E2E Tests
    runs-on: ubuntu-latest
    needs: build
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
        with:
          bun-version: ${{ env.BUN_VERSION }}

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Compile i18n messages
        run: bun run i18n:compile

      # E2E runs the app in Docker against an isolated test database and uses
      # Playwright with mock payment/shipping providers (no external services).
      - name: Run E2E tests
        run: make e2e

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: playwright-report
          path: |
            e2e/report
            e2e/test-results
          retention-days: 7
