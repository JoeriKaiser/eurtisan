# Caddy reverse proxy configuration
# Domain is injected via the CADDY_DOMAIN environment variable

{$CADDY_DOMAIN} {
	# Compression — gzip and zstd are included in the official Caddy image.
	# Brotli is intentionally omitted because it requires a third-party plugin.
	encode gzip zstd

	# Faro collector endpoint
	handle /collect* {
		reverse_proxy alloy:8027
	}

	# Grafana UI — restrict to admin IPs only.
	# Set GRAFANA_ADMIN_IPS to a space-separated list of CIDR ranges.
	# Defaults to 0.0.0.0/32 so the route is blocked if the variable is not set.
	handle /grafana* {
		@not_admin not remote_ip {$GRAFANA_ADMIN_IPS:0.0.0.0/32}
		respond @not_admin "Forbidden" 403
		reverse_proxy grafana:3000
	}

	# Same-origin image delivery. handle_path strips /uploads before imgproxy.
	handle_path /uploads/* {
		reverse_proxy imgproxy:8080
	}

	# Browser search uses a restricted search-only key. The master key remains
	# server-only; handle_path strips the public prefix before Meilisearch.
	#
	# The search key is public by design (it ships in the JS bundle), so this
	# route is defended at the edge as well: only the search endpoints are
	# reachable, and the rate limit bounds scraping and query floods. Paths are
	# matched after handle_path has stripped the /meilisearch prefix.
	handle_path /meilisearch/* {
		@search_endpoints {
			method POST
			path /indexes/products/search /indexes/products/facet-search /multi-search
		}
		handle @search_endpoints {
			rate_limit {
				zone search {
					key {remote_host}
					events 120
					window 1m
				}
			}
			reverse_proxy meilisearch:7700
		}
		# Everything else on the Meilisearch API (documents, keys, tasks, dumps,
		# stats, settings) is never needed by a browser.
		handle {
			respond "Forbidden" 403
		}
	}

	# Edge rate limiting for authentication endpoints
	handle /api/auth* {
		rate_limit {
			zone auth {
				key {remote_host}
				events 20
				window 1m
			}
		}
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Main application
	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Stricter referrer policy on checkout and order flows
	@checkout_paths path /checkout /cart /orders*
	header @checkout_paths Referrer-Policy "strict-origin"

	# Security headers
	header {
		Vary "Accept-Encoding, Accept-Language"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Expect-CT "max-age=86400, enforce"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Document-Policy "force-load-at-top"
		# Baseline edge CSP — covers all known external resources used by the app
		# (Mollie, Brevo, Meilisearch, Umami). The app emits a nonce-based policy
		# for HTML responses; this line protects non-app responses (error pages,
		# static files, upstream services). Inline scripts are not allowed here.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.umami.is https://analytics.eurtisan.eu; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.mollie.com https://api.brevo.com https://cdn.umami.is https://api.umami.is https://analytics.eurtisan.eu; frame-src 'self' https://checkout.mollie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# Automatic HTTPS via Let's Encrypt
	# Caddy handles certificate provisioning and renewal
}
