# Caddy reverse proxy configuration
# Domain is injected via the CADDY_DOMAIN environment variable

{$CADDY_DOMAIN} {
	# Faro collector endpoint
	handle /collect* {
		reverse_proxy alloy:8027
	}

	# Grafana UI
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Image serving via imgproxy
	handle /uploads/* {
		reverse_proxy imgproxy:8080
	}

	# Main application
	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Automatic HTTPS via Let's Encrypt
	# Caddy handles certificate provisioning and renewal
}
