¶Caddyfile#CE69
1:# Caddy reverse proxy configuration
2:# Domain is injected via the CADDY_DOMAIN environment variable
3:
4:{$CADDY_DOMAIN} {
5:	# Compression — brotli requires the caddy-brotli plugin (https://github.com/darkweak/caddy-brotli)
6:	encode brotli gzip zstd
7:
8:	# Faro collector endpoint
9:	handle /collect* {
10:		reverse_proxy alloy:8027
11:	}
12:
13:	# Grafana UI — restrict to admin IPs only
14:	# TODO: Replace with actual admin IP ranges before production
15:	handle /grafana* {
16:		# @not_admin not remote_ip 1.2.3.4/32 10.0.0.0/24
17:		# respond @not_admin "Forbidden" 403
18:		reverse_proxy grafana:3000
19:	}
20:
21:	# Image serving via imgproxy
22:	handle /uploads/* {
23:		reverse_proxy imgproxy:8080
24:	}
25:
26:	# Edge rate limiting for authentication endpoints
27:	handle /api/auth* {
28:		rate_limit {
29:			zone auth {
30:				key {remote_host}
31:				events 20
32:				window 1m
33:			}
34:		}
35:		reverse_proxy app:3000 {
36:			header_up X-Forwarded-Proto {scheme}
37:			header_up X-Forwarded-Host {host}
38:		}
39:	}
40:
41:	# Main application
42:	handle {
43:		reverse_proxy app:3000 {
44:			header_up X-Forwarded-Proto {scheme}
45:			header_up X-Forwarded-Host {host}
46:		}
47:	}
48:
49:	# Stricter referrer policy on checkout and order flows
50:	@checkout_paths path /checkout /cart /orders*
51:	header @checkout_paths Referrer-Policy "strict-origin"
52:
53:	# Security headers
54:	header {
55:		Vary "Accept-Encoding, Accept-Language"
56:		X-Content-Type-Options "nosniff"
57:		X-Frame-Options "DENY"
58:		Referrer-Policy "strict-origin-when-cross-origin"
59:		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Expect-CT "max-age=86400, enforce"
60:		Cross-Origin-Opener-Policy "same-origin"
61:		Cross-Origin-Embedder-Policy "require-corp"
62:		Cross-Origin-Resource-Policy "same-origin"
63:		Document-Policy "force-load-at-top"
64:		# Baseline edge CSP — covers all known external resources used by the app
65:		# (Mollie, Brevo, Meilisearch, Umami). The app may emit a
66:		# more specific policy at runtime; this ensures non-app responses
67:		# (error pages, static files, upstream services) are also protected.
68:		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.umami.is https://analytics.eurtisan.eu; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.mollie.com https://api.brevo.com https://search.eurtisan.eu https://cdn.umami.is https://api.umami.is https://analytics.eurtisan.eu; frame-src 'self' https://checkout.mollie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
69:		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
70:	}
71:
72:	# Automatic HTTPS via Let's Encrypt
73:	# Caddy handles certificate provisioning and renewal
74:}
