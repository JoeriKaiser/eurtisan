# pgBackRest process environment
# Generated by Ansible and mounted only into the PostgreSQL container.
PGBACKREST_REPO1_CIPHER_PASS={{ pgbackrest_repo_cipher_pass }}
{% if pgbackrest_repository_type == 's3' %}
PGBACKREST_REPO1_S3_KEY={{ pgbackrest_s3_access_key }}
PGBACKREST_REPO1_S3_KEY_SECRET={{ pgbackrest_s3_secret_key }}
{% endif %}
