#!/bin/bash
set -euo pipefail

COMPOSE_FILE="{{ compose_file }}"
BACKUP_DIR="/opt/eurtisan/backups"
BACKUP_RETENTION_DAYS="{{ backup_retention_days | default(30) }}"
BACKUP_OFFSITE_RETENTION_DAYS="{{ backup_offsite_retention_days | default(90) }}"
OFFSITE_REMOTE="{{ backup_offsite_rclone_remote | default('') }}"
POSTGRES_USER="{{ postgres_user }}"
POSTGRES_DB="{{ postgres_db }}"
WEBHOOK_URL="{{ backup_alert_webhook | default('') }}"
BACKUP_REPORT_TOKEN="{{ backup_report_token | default('') }}"
MEILISEARCH_HOST="{{ meilisearch_host | default('http://meilisearch:7700') }}"
MEILISEARCH_API_KEY="{{ meilisearch_api_key | default('') }}"
S3_UPLOADS_BUCKET="{{ s3_uploads_bucket | default('') }}"
S3_UPLOADS_REMOTE="{{ backup_s3_uploads_rclone_remote | default('') }}"
WAL_ARCHIVE_PATH="{{ postgres_wal_archive_path | default('/opt/eurtisan/backups/wal') }}"

json_log() {
  local level="$1"
  local message="$2"
  local meta="${3:-{}}"
  printf '{"timestamp":"%s","level":"%s","service":"eurtisan-backup","message":"%s","meta":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$level" "$message" "$meta"
}

send_alert() {
  local message="$1"
  if [[ -n "$WEBHOOK_URL" ]]; then
    curl -fsSL -X POST -H "Content-Type: application/json" \
      -d "{\"text\":\"$message\"}" "$WEBHOOK_URL" >/dev/null 2>&1 || true
  fi
}

BACKUP_FAILED=false
BACKUP_ERROR=""

report_backup() {
  if [[ -z "$BACKUP_REPORT_TOKEN" ]]; then
    return 0
  fi

  local status="success"
  if [[ "$BACKUP_FAILED" == "true" ]]; then
    status="failure"
  fi

  curl -fsS -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $BACKUP_REPORT_TOKEN" \
    -d "{\"status\":\"$status\",\"file\":\"$BACKUP_FILE\",\"error\":\"$BACKUP_ERROR\"}" \
    "http://app:3000/api/backup-report" >/dev/null 2>&1 || true
}

cleanup() {
  docker rm -f eurtisan-backup-verify 2>/dev/null || true
  docker network rm eurtisan-backup-verify-net 2>/dev/null || true
}
trap cleanup EXIT
trap report_backup EXIT

mkdir -p "$BACKUP_DIR"
BACKUP_FILE="$BACKUP_DIR/eurtisan-$(date +%Y%m%d-%H%M%S).sql.gz"
DUMP_DATE_PREFIX="$(date +%Y%m%d-%H%M%S)"

json_log "info" "Backup job started" "{\"file\":\"$BACKUP_FILE\"}"

# 1. Create backup
if ! docker compose -f "/opt/eurtisan/$COMPOSE_FILE" exec -T db pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" | gzip > "$BACKUP_FILE"; then
  BACKUP_FAILED=true
  BACKUP_ERROR="Backup creation failed"
  json_log "error" "$BACKUP_ERROR" "{\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

BACKUP_SIZE=$(stat -c%s "$BACKUP_FILE" 2>/dev/null || echo "0")
json_log "info" "Backup created" "{\"file\":\"$BACKUP_FILE\",\"size_bytes\":$BACKUP_SIZE}"

# 2. Verify backup integrity (test restore)
VERIFY_DB="verify_$(date +%s)"
VERIFY_CONTAINER="eurtisan-backup-verify"
VERIFY_NET="eurtisan-backup-verify-net"

docker network create "$VERIFY_NET" 2>/dev/null || true

if ! docker run -d --name "$VERIFY_CONTAINER" \
  --network "$VERIFY_NET" \
  -e POSTGRES_USER=verify \
  -e POSTGRES_PASSWORD=verify \
  -e POSTGRES_DB="$VERIFY_DB" \
  --health-cmd="pg_isready -U verify" \
  --health-interval=2s \
  --health-timeout=5s \
  --health-retries=15 \
  postgres:16-alpine >/dev/null; then
  BACKUP_FAILED=true
  BACKUP_ERROR="Could not start verification container"
  json_log "error" "$BACKUP_ERROR" "{\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

# Wait for PostgreSQL to be ready (up to 60s)
READY=0
for i in $(seq 1 30); do
  if docker exec "$VERIFY_CONTAINER" pg_isready -U verify >/dev/null 2>&1; then
    READY=1
    break
  fi
  sleep 2
done

if [[ "$READY" -ne 1 ]]; then
  BACKUP_FAILED=true
  BACKUP_ERROR="Verification container timeout"
  json_log "error" "$BACKUP_ERROR" "{\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

# Restore the backup
if ! gunzip -c "$BACKUP_FILE" | docker exec -i "$VERIFY_CONTAINER" psql -U verify -d "$VERIFY_DB" >/dev/null 2>&1; then
  BACKUP_FAILED=true
  BACKUP_ERROR="Test restore failed"
  json_log "error" "$BACKUP_ERROR" "{\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

json_log "info" "Test restore succeeded" "{\"file\":\"$BACKUP_FILE\"}"

# 3. Verify expected tables exist
EXPECTED_TABLES=("user" "session" "account" "verification" "shop" "category")
MISSING=()
for table in "${EXPECTED_TABLES[@]}"; do
  COUNT=$(docker exec "$VERIFY_CONTAINER" psql -U verify -d "$VERIFY_DB" -tAc \
    "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='public' AND table_name='$table';" 2>/dev/null || echo "0")
  if [[ "$COUNT" -eq 0 ]]; then
    MISSING+=("$table")
  fi
done

TOTAL_TABLES=$(docker exec "$VERIFY_CONTAINER" psql -U verify -d "$VERIFY_DB" -tAc \
  "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='public';" 2>/dev/null || echo "0")

if [[ {{ '${#' }}MISSING[@]} -gt 0 ]]; then
  MISSING_STR=$(printf '%s,' "${MISSING[@]}")
  MISSING_STR="${MISSING_STR%,}"
  BACKUP_FAILED=true
  BACKUP_ERROR="Missing expected tables: $MISSING_STR"
  json_log "error" "Backup verification failed: missing expected tables" "{\"missing_tables\":\"$MISSING_STR\",\"total_tables\":$TOTAL_TABLES,\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

if [[ "$TOTAL_TABLES" -eq 0 ]]; then
  BACKUP_FAILED=true
  BACKUP_ERROR="Restored database is empty"
  json_log "error" "Backup verification failed: no tables in restored database" "{\"file\":\"$BACKUP_FILE\"}"
  send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
  exit 1
fi

json_log "info" "Backup verification completed successfully" "{\"file\":\"$BACKUP_FILE\",\"total_tables\":$TOTAL_TABLES}"

# 4. Meilisearch dump
if [[ -n "$MEILISEARCH_API_KEY" ]]; then
  MEILI_DUMP_DIR="$BACKUP_DIR/meilisearch-$DUMP_DATE_PREFIX"
  mkdir -p "$MEILI_DUMP_DIR"

  json_log "info" "Starting Meilisearch dump" "{\"host\":\"$MEILISEARCH_HOST\"}"

  # Trigger a dump; Meilisearch returns a task UID we could poll, but the dump
  # endpoint is synchronous enough for our needs. A Meilisearch dump failure is
  # now considered a backup failure because search indexes are part of the
  # recoverable dataset.
  if curl -fsS -X POST "$MEILISEARCH_HOST/dumps" \
    -H "Authorization: Bearer $MEILISEARCH_API_KEY" \
    -o "$MEILI_DUMP_DIR/dump-response.json" 2>/dev/null; then

    DUMP_UID=$(python3 -c "import json,sys; print(json.load(open('$MEILI_DUMP_DIR/dump-response.json')).get('taskUid',''))" 2>/dev/null || true)
    if [[ -n "$DUMP_UID" ]]; then
      json_log "info" "Meilisearch dump task created" "{\"taskUid\":$DUMP_UID}"
    else
      # Meilisearch < v1.8 returns the dump file path directly.
      json_log "info" "Meilisearch dump response saved" "{}"
    fi
  else
    BACKUP_FAILED=true
    BACKUP_ERROR="Meilisearch dump failed"
    json_log "error" "$BACKUP_ERROR" "{}"
    send_alert "🚨 Eurtisan backup FAILED on $(hostname): $BACKUP_ERROR"
    exit 1
  fi
fi

# 5. Off-site upload
if [[ -n "$OFFSITE_REMOTE" ]]; then
  json_log "info" "Uploading database backup off-site" "{\"remote\":\"$OFFSITE_REMOTE\",\"file\":\"$BACKUP_FILE\"}"

  if ! rclone copyto "$BACKUP_FILE" "${OFFSITE_REMOTE}/$(basename "$BACKUP_FILE")"; then
    BACKUP_FAILED=true
    BACKUP_ERROR="Off-site backup upload failed"
    json_log "error" "$BACKUP_ERROR" "{\"file\":\"$BACKUP_FILE\",\"remote\":\"$OFFSITE_REMOTE\"}"
    send_alert "🚨 Eurtisan backup WARNING on $(hostname): local backup OK, but $BACKUP_ERROR"
    exit 1
  fi

  json_log "info" "Off-site backup upload succeeded" "{\"file\":\"$BACKUP_FILE\",\"remote\":\"$OFFSITE_REMOTE\"}"

  # Prune off-site backups older than the configured retention. Best-effort:
  # failures are logged but do not fail the job, because the local backup is
  # still valid and a bucket lifecycle rule (preferred) may already handle this.
  if rclone lsf "$OFFSITE_REMOTE" >/dev/null 2>&1; then
    rclone delete --min-age "${BACKUP_OFFSITE_RETENTION_DAYS}d" "$OFFSITE_REMOTE" >/dev/null 2>&1 || true
    json_log "info" "Pruned off-site backups older than ${BACKUP_OFFSITE_RETENTION_DAYS} days" "{\"remote\":\"$OFFSITE_REMOTE\"}"
  fi
fi

# 6. S3 uploads sync (secondary copy)
if [[ -n "$S3_UPLOADS_REMOTE" && -n "$OFFSITE_REMOTE" ]]; then
  json_log "info" "Syncing S3 uploads bucket off-site" "{\"remote\":\"$S3_UPLOADS_REMOTE\"}"

  if ! rclone sync "$S3_UPLOADS_REMOTE" "${OFFSITE_REMOTE}/uploads-${DUMP_DATE_PREFIX}"; then
    json_log "warn" "S3 uploads off-site sync failed" "{\"remote\":\"$S3_UPLOADS_REMOTE\"}"
    send_alert "⚠️ Eurtisan backup warning on $(hostname): S3 uploads off-site sync failed"
  else
    json_log "info" "S3 uploads off-site sync completed" "{\"remote\":\"$S3_UPLOADS_REMOTE\"}"
  fi
fi

# 7. Cleanup old local backups
DELETED=$(find "$BACKUP_DIR" -name "*.sql.gz" -mtime +"$BACKUP_RETENTION_DAYS" -print -delete 2>/dev/null | wc -l)
json_log "info" "Pruned old backups" "{\"deleted\":$DELETED,\"retention_days\":$BACKUP_RETENTION_DAYS}"

# Cleanup old local Meilisearch dumps
MEILI_DELETED=$(find "$BACKUP_DIR" -maxdepth 1 -type d -name "meilisearch-*" -mtime +"$BACKUP_RETENTION_DAYS" -print -delete 2>/dev/null | wc -l)
json_log "info" "Pruned old Meilisearch dumps" "{\"deleted\":$MEILI_DELETED,\"retention_days\":$BACKUP_RETENTION_DAYS}"

# Cleanup old local WAL segments
if [[ -d "$WAL_ARCHIVE_PATH" ]]; then
  WAL_DELETED=$(find "$WAL_ARCHIVE_PATH" -type f -mtime +"$BACKUP_RETENTION_DAYS" -print -delete 2>/dev/null | wc -l)
  json_log "info" "Pruned old WAL segments" "{\"deleted\":$WAL_DELETED,\"retention_days\":$BACKUP_RETENTION_DAYS,\"path\":\"$WAL_ARCHIVE_PATH\"}"
fi

json_log "info" "Backup job completed successfully" "{\"file\":\"$BACKUP_FILE\"}"
