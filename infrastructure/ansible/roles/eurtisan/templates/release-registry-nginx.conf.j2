user nginx;
worker_processes auto;
pid /tmp/nginx.pid;

error_log /dev/stderr notice;

events {
  worker_connections 1024;
}

http {
  access_log /dev/stdout;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  proxy_request_buffering off;

  upstream release_registry {
    server registry:5000;
    keepalive 16;
  }

  server {
    listen 8080;
    server_name _;
    client_max_body_size 0;

    location = /healthz {
      access_log off;
      return 200 "ok\n";
    }

    location /v2/ {
      auth_basic "Eurtisan release registry";
      auth_basic_user_file /etc/nginx/auth/registry-users.htpasswd;

      # Pulls use GET/HEAD. Every mutating Registry API method must also pass
      # the controller-only credential file, so the VPS pull credential cannot
      # publish or delete release artifacts.
      limit_except GET HEAD {
        auth_basic "Eurtisan release registry (push)";
        auth_basic_user_file /etc/nginx/auth/registry-push.htpasswd;
      }

      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Docker-Distribution-Api-Version registry/2.0;
      proxy_read_timeout 900;
      proxy_send_timeout 900;
      proxy_pass http://release_registry;
    }

    location / {
      return 404;
    }
  }
}
