# Eurtisan backup runtime configuration
# Generated by Ansible. Readable only by root and the backup operator group.
BACKUP_DIR={{ backup_directory | quote }}
BACKUP_STATE_DIR={{ backup_state_directory | quote }}
BACKUP_RETENTION_DAYS={{ backup_retention_days | quote }}
BACKUP_LOGICAL_CIPHER_PASS={{ backup_logical_cipher_pass | quote }}
BACKUP_OFFSITE_ENABLED={{ (backup_offsite_enabled | bool) | ternary('true', 'false') }}
BACKUP_OFFSITE_REMOTE={{ backup_offsite_rclone_remote | default('') | quote }}
BACKUP_PRIMARY_UPLOADS_REMOTE={{ backup_primary_uploads_rclone_remote | default('') | quote }}
BACKUP_OFFSITE_UPLOADS_REMOTE={{ backup_offsite_uploads_rclone_remote | default('') | quote }}
BACKUP_REPORT_TOKEN={{ backup_report_token | default(metrics_token) | quote }}
BACKUP_ALERT_WEBHOOK={{ backup_alert_webhook | default('') | quote }}
POSTGRES_USER={{ postgres_user | quote }}
POSTGRES_DB={{ postgres_db | quote }}
DB_CONTAINER={{ db_container_name | quote }}
APP_CONTAINER={{ app_container_name | quote }}
PGBACKREST_ENABLED={{ (postgres_wal_archive_enabled | bool) | ternary('true', 'false') }}
PGBACKREST_STANZA={{ pgbackrest_stanza | quote }}
POSTGRES_VERIFY_IMAGE={{ postgres_verify_image | quote }}

{% if backup_offsite_enabled | bool %}
# rclone remotes are configured through protected environment variables rather
# than an interactive per-user config file.
RCLONE_CONFIG_BACKUPSTORAGE_TYPE=s3
RCLONE_CONFIG_BACKUPSTORAGE_PROVIDER=Other
RCLONE_CONFIG_BACKUPSTORAGE_ENDPOINT={{ backup_object_storage_endpoint | quote }}
RCLONE_CONFIG_BACKUPSTORAGE_REGION={{ backup_object_storage_region | quote }}
RCLONE_CONFIG_BACKUPSTORAGE_ACCESS_KEY_ID={{ backup_logical_s3_access_key | quote }}
RCLONE_CONFIG_BACKUPSTORAGE_SECRET_ACCESS_KEY={{ backup_logical_s3_secret_key | quote }}
RCLONE_CONFIG_BACKUPSTORAGE_NO_CHECK_BUCKET=true
RCLONE_CONFIG_BACKUPOFFSITE_TYPE=crypt
RCLONE_CONFIG_BACKUPOFFSITE_REMOTE={{ ('backupstorage:' ~ backup_logical_s3_bucket ~ '/logical') | quote }}
RCLONE_CONFIG_BACKUPOFFSITE_PASSWORD={{ backup_rclone_crypt_password | quote }}
RCLONE_CONFIG_BACKUPOFFSITE_FILENAME_ENCRYPTION=standard

RCLONE_CONFIG_PRIMARYUPLOADS_TYPE=s3
RCLONE_CONFIG_PRIMARYUPLOADS_PROVIDER=Other
RCLONE_CONFIG_PRIMARYUPLOADS_ENDPOINT={{ s3_endpoint | quote }}
RCLONE_CONFIG_PRIMARYUPLOADS_REGION={{ s3_region | quote }}
RCLONE_CONFIG_PRIMARYUPLOADS_ACCESS_KEY_ID={{ backup_primary_uploads_access_key | quote }}
RCLONE_CONFIG_PRIMARYUPLOADS_SECRET_ACCESS_KEY={{ backup_primary_uploads_secret_key | quote }}
RCLONE_CONFIG_PRIMARYUPLOADS_NO_CHECK_BUCKET=true
{% endif %}
