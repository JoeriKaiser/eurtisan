# Eurtisan Production Environment
# Generated by Ansible — do not edit manually on the server.

NODE_ENV=production
CADDY_DOMAIN={{ caddy_domain }}

BETTER_AUTH_URL=https://{{ caddy_domain }}
BETTER_AUTH_SECRET={{ better_auth_secret }}

DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@db:5432/{{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}

MEILISEARCH_HOST=http://meilisearch:7700
# Master key — server-side only (admin / index management / document writes)
MEILISEARCH_API_KEY={{ meilisearch_api_key }}
# Meilisearch container requires MEILI_MASTER_KEY (same value as above)
MEILI_MASTER_KEY={{ meilisearch_api_key }}

# Browser-facing search-only key (generated via Meilisearch /keys API)
VITE_MEILISEARCH_HOST=http://meilisearch:7700
{% if meilisearch_search_key is defined %}
VITE_MEILISEARCH_SEARCH_KEY={{ meilisearch_search_key }}
{% endif %}

# ── Observability (Grafana Stack — self-hosted) ───────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=production
VITE_APP_VERSION={{ git_branch | default('main') }}

# Grafana admin password (only used on first boot; change via UI afterward)
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('changeme') }}
GRAFANA_ROOT_URL=https://{{ caddy_domain }}/grafana

{% if mollie_api_key is defined %}
MOLLIE_API_KEY={{ mollie_api_key }}
{% endif %}
{% if mollie_webhook_secret is defined %}
MOLLIE_WEBHOOK_SECRET={{ mollie_webhook_secret }}
{% endif %}

{% if mondial_relay_api_key is defined %}
MONDIAL_RELAY_API_KEY={{ mondial_relay_api_key }}
{% endif %}

{% if brevo_api_key is defined %}
BREVO_API_KEY={{ brevo_api_key }}
{% endif %}
EMAIL_FROM_ADDRESS={{ email_from_address | default('noreply@eurtisan.eu') }}
EMAIL_FROM_NAME={{ email_from_name | default('Eurtisan') }}

{% if coexist_with_proxy | default(false) %}
# Staging — route emails through Mailpit (captures instead of sending)
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
{% elif email_smtp_host is defined %}
EMAIL_SMTP_HOST={{ email_smtp_host }}
EMAIL_SMTP_PORT={{ email_smtp_port | default('587') }}
{% endif %}
