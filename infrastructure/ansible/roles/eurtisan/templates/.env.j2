# Eurtisan Production Environment
# Generated by Ansible — do not edit manually on the server.

NODE_ENV=production
CADDY_DOMAIN={{ caddy_domain }}

# Public URL of the application (required for SSR, emails, and absolute links)
PUBLIC_URL=https://{{ caddy_domain }}

BETTER_AUTH_URL=https://{{ caddy_domain }}
BETTER_AUTH_SECRET={{ better_auth_secret }}

DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@db:5432/{{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}

{% if postgres_wal_archive_enabled | default(false) %}
POSTGRES_WAL_ARCHIVE_ENABLED=true
POSTGRES_WAL_ARCHIVE_PATH={{ postgres_wal_archive_path }}
{% else %}
POSTGRES_WAL_ARCHIVE_ENABLED=false
{% endif %}

MEILISEARCH_HOST=http://meilisearch:7700
# Master key — server-side only (admin / index management / document writes)
MEILISEARCH_API_KEY={{ meilisearch_api_key }}
# Meilisearch container requires MEILI_MASTER_KEY (same value as above)
MEILI_MASTER_KEY={{ meilisearch_api_key }}

# Browser-facing search-only key (generated via Meilisearch /keys API)
VITE_MEILISEARCH_HOST=http://meilisearch:7700
{% if meilisearch_search_key is defined %}
VITE_MEILISEARCH_SEARCH_KEY={{ meilisearch_search_key }}
{% endif %}

# ── Observability (Grafana Stack — self-hosted) ───────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=production
VITE_APP_VERSION={{ git_branch | default('main') }}

# Grafana admin password (only used on first boot; change via UI afterward)
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_ROOT_URL=https://{{ caddy_domain }}/grafana

{% if umami_script_url is defined %}
VITE_UMAMI_SCRIPT_URL={{ umami_script_url }}
{% endif %}
{% if umami_website_id is defined %}
VITE_UMAMI_WEBSITE_ID={{ umami_website_id }}
{% endif %}
{% if umami_host_url is defined %}
VITE_UMAMI_HOST_URL={{ umami_host_url }}
{% endif %}

{% if mollie_api_key is defined %}
MOLLIE_API_KEY={{ mollie_api_key }}
{% endif %}
{% if mollie_webhook_secret is defined %}
MOLLIE_WEBHOOK_SECRET={{ mollie_webhook_secret }}
{% endif %}
{% if mollie_client_id is defined %}
MOLLIE_CLIENT_ID={{ mollie_client_id }}
{% endif %}
{% if mollie_client_secret is defined %}
MOLLIE_CLIENT_SECRET={{ mollie_client_secret }}
{% endif %}

{% if sendcloud_public_key is defined %}
SENDCLOUD_PUBLIC_KEY={{ sendcloud_public_key }}
{% endif %}
{% if sendcloud_secret_key is defined %}
SENDCLOUD_SECRET_KEY={{ sendcloud_secret_key }}
{% endif %}
{% if sendcloud_webhook_secret is defined %}
SENDCLOUD_WEBHOOK_SECRET={{ sendcloud_webhook_secret }}
{% endif %}
{% if sendcloud_unstamped_letter_method_id is defined %}
SENDCLOUD_UNSTAMPED_LETTER_METHOD_ID={{ sendcloud_unstamped_letter_method_id }}
{% endif %}
{% if sendcloud_force_unstamped_letter is defined %}
SENDCLOUD_FORCE_UNSTAMPED_LETTER={{ sendcloud_force_unstamped_letter }}

{% if sendcloud_reconciliation_interval_ms is defined %}
SENDCLOUD_RECONCILIATION_INTERVAL_MS={{ sendcloud_reconciliation_interval_ms }}
{% endif %}
{% endif %}

{% if brevo_api_key is defined %}
BREVO_API_KEY={{ brevo_api_key }}
{% endif %}
# Use noreply@mail.eurtisan.eu once the dedicated subdomain is verified in Brevo.
# See docs/EMAIL_DNS.md for SPF/DKIM/DMARC setup.
EMAIL_FROM_ADDRESS={{ email_from_address | default('noreply@eurtisan.eu') }}
EMAIL_FROM_NAME={{ email_from_name | default('Eurtisan') }}

{% if coexist_with_proxy | default(false) %}
# Staging — route emails through Mailpit (captures instead of sending)
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
{% elif email_smtp_host is defined %}
EMAIL_SMTP_HOST={{ email_smtp_host }}
EMAIL_SMTP_PORT={{ email_smtp_port | default('587') }}
{% endif %}

# ── Mock mode safeguards ─────────────────────────────────────────────────
MOCK_PAYMENTS_ENABLED={{ mock_payments_enabled | default('false') }}
MOCK_PAYOUTS_ENABLED={{ mock_payouts_enabled | default('false') }}

# ── Analytics consent ────────────────────────────────────────────────────
VITE_ANALYTICS_CONSENT_REQUIRED={{ analytics_consent_required | default('true') }}

# ── Grafana access control ───────────────────────────────────────────────
GRAFANA_ADMIN_IPS={{ grafana_admin_ips | default('') }}

# ── Observability wiring ─────────────────────────────────────────────────
APP_CONTAINER_NAME={{ app_container_name | default('eurtisan-app') }}
ALLOY_FARO_CORS_ORIGINS={{ alloy_faro_cors_origins | default('https://eurtisan.eu,https://staging.eurtisan.eu') }}

# ── Metrics scrape protection ────────────────────────────────────────────
{% if metrics_token is defined %}
METRICS_TOKEN={{ metrics_token }}
{% endif %}

# ── Health checks ────────────────────────────────────────────────────────
HEALTH_DISK_PATH={{ health_disk_path | default('/') }}
HEALTH_DISK_THRESHOLD_BYTES={{ health_disk_threshold_bytes | default('524288000') }}

# ── Background-job tuning ────────────────────────────────────────────────
PAYOUT_RECONCILIATION_INTERVAL_MS={{ payout_reconciliation_interval_ms | default('21600000') }}
SENDCLOUD_RECONCILIATION_INTERVAL_MS={{ sendcloud_reconciliation_interval_ms | default('21600000') }}
AUDIT_LOG_RETENTION_DAYS={{ audit_log_retention_days | default('365') }}

# ── Backup / off-site ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS={{ backup_retention_days | default('30') }}
BACKUP_OFFSITE_RETENTION_DAYS={{ backup_offsite_retention_days | default('90') }}
{% if backup_offsite_rclone_remote is defined and backup_offsite_rclone_remote %}
BACKUP_OFFSITE_RCLONE_REMOTE={{ backup_offsite_rclone_remote }}
{% endif %}
{% if backup_s3_uploads_rclone_remote is defined and backup_s3_uploads_rclone_remote %}
BACKUP_S3_UPLOADS_RCLONE_REMOTE={{ backup_s3_uploads_rclone_remote }}
{% endif %}

# ── Email pipeline & alerting ────────────────────────────────────────────
# Brevo webhook authentication.
# Configure the Brevo webhook with Bearer auth pointing to:
#   POST /api/webhooks/brevo
#   Authorization: Bearer <BREVO_WEBHOOK_TOKEN>
# Must be at least 64 cryptographically random characters.
BREVO_WEBHOOK_TOKEN={{ brevo_webhook_token | default('') }}

# Email outbox worker tuning.
EMAIL_OUTBOX_WORKER_INTERVAL_MS={{ email_outbox_worker_interval_ms | default('10000') }}
EMAIL_OUTBOX_WORKER_BATCH_SIZE={{ email_outbox_worker_batch_size | default('50') }}
EMAIL_MAX_RETRIES={{ email_max_retries | default('3') }}

# Auth email rate limits.
EMAIL_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_DAY={{ email_rate_limit_password_reset_per_email_day | default('5') }}
EMAIL_RATE_LIMIT_VERIFICATION_PER_EMAIL_DAY={{ email_rate_limit_verification_per_email_day | default('5') }}
EMAIL_RATE_LIMIT_SECURITY_ALERT_PER_EMAIL_HOUR={{ email_rate_limit_security_alert_per_email_hour | default('10') }}

# Email retention (days).
EMAIL_SUPPRESSION_SOFT_BOUNCE_RETENTION_DAYS={{ email_suppression_soft_bounce_retention_days | default('30') }}
EMAIL_SEND_LOG_RETENTION_DAYS={{ email_send_log_retention_days | default('90') }}

# Alertmanager routing (at least one receiver is required in production).
ALERTMANAGER_SMTP_HOST={{ alertmanager_smtp_host | default('') }}
ALERTMANAGER_SMTP_PORT={{ alertmanager_smtp_port | default('587') }}
ALERTMANAGER_SMTP_FROM={{ alertmanager_smtp_from | default('') }}
ALERTMANAGER_SMTP_TO={{ alertmanager_smtp_to | default('') }}
ALERTMANAGER_WEBHOOK_URL={{ alertmanager_webhook_url | default('') }}

# Deploy notifications (defaults to BACKUP_ALERT_WEBHOOK if unset).
{% if deploy_alert_webhook is defined and deploy_alert_webhook %}
DEPLOY_ALERT_WEBHOOK={{ deploy_alert_webhook }}
{% endif %}
