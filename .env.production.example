# Eurtisan Production Environment Variables
# Copy this file to .env on the VPS and fill in all secrets.
# NEVER commit the real .env file to Git.

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=production
CADDY_DOMAIN=eurtisan.eu

# ── Better Auth ──────────────────────────────────────────────────────────
# Public URL of the application (must match Caddy domain)
BETTER_AUTH_URL=https://eurtisan.eu
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
# These values must match the db service credentials
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan
POSTGRES_USER=eurtisan
# Change this to a strong random password
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=eurtisan

# ── Meilisearch ──────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
# Generate a strong API key for production
MEILISEARCH_API_KEY=change-me-in-production
# Meilisearch container requires this exact variable name
MEILI_MASTER_KEY=change-me-in-production

# ── Observability (Grafana Stack — self-hosted) ──────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=production
VITE_APP_VERSION=prod

# Grafana admin password (only used on first boot; change via UI afterward)
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GRAFANA_ROOT_URL=https://eurtisan.eu/grafana

# ── Payments ─────────────────────────────────────────────────────────────
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# ── Shipping ─────────────────────────────────────────────────────────────
MONDIAL_RELAY_API_KEY=

# ── Email (Brevo — EU transactional email) ───────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan

# Email SMTP fallback (optional — falls back to Brevo HTTP API when empty)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
