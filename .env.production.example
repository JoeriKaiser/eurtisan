# Eurtisan Production Environment Variables
# Copy this file to .env on the VPS and fill in all secrets.
# NEVER commit the real .env file to Git.

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=production
CADDY_DOMAIN=eurtisan.eu

# Public URL of the application (required for SSR, emails, and absolute links)
PUBLIC_URL=https://eurtisan.eu

# ── Better Auth ──────────────────────────────────────────────────────────
# Public URL of the application (must match Caddy domain)
BETTER_AUTH_URL=https://eurtisan.eu
# Generate with: openssl rand -base64 32 (required in production)
BETTER_AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
# These values must match the db service credentials
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan
POSTGRES_USER=eurtisan
# Change this to a strong random password
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=eurtisan

# ── Meilisearch ──────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
# Master key — server-side ONLY. Never expose to the browser.
MEILISEARCH_API_KEY=change-me-in-production
# Meilisearch container requires this exact variable name
MEILI_MASTER_KEY=change-me-in-production

# Browser-facing search-only key.
# Generate after Meilisearch boots: POST /keys with actions=["search"], indexes=["products"]
VITE_MEILISEARCH_HOST=http://meilisearch:7700
VITE_MEILISEARCH_SEARCH_KEY=change-me-in-production

# ── Observability (Grafana Stack — self-hosted) ──────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=production
VITE_APP_VERSION=prod

# Grafana admin password (only used on first boot; change via UI afterward)
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GRAFANA_ROOT_URL=https://eurtisan.eu/grafana

# ── Umami (Cookie-less Analytics) ────────────────────────────────────────
# Optional — leave empty to disable Umami tracking.
# VITE_UMAMI_SCRIPT_URL=
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_HOST_URL=

# ── Payments ─────────────────────────────────────────────────────────────
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Mollie Connect (seller onboarding and payouts)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Mollie test mode. Must be 'false' in production.
MOLLIE_TEST_MODE=false

# Payout reconciliation job interval (milliseconds). Default: 6 hours.
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000

# ── Shipping ─────────────────────────────────────────────────────────────
MONDIAL_RELAY_API_KEY=

# ── Email (Brevo — EU transactional email) ───────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan

# Email SMTP fallback (optional — falls back to Brevo HTTP API when empty)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Request body size limits (bytes)
# Webhook routes use a stricter default to prevent abuse.
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576

# Rate-limit cleanup retention (days)
# Stale rate_limit rows older than this are deleted after each check.
RATE_LIMIT_RETENTION_DAYS=30
