# Eurtisan Production Environment Variables
# Copy this file to .env on the VPS and fill in all secrets.
# NEVER commit the real .env file to Git.

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=production
CADDY_DOMAIN=eurtisan.eu

# Public URL of the application (required for SSR, emails, and absolute links)
PUBLIC_URL=https://eurtisan.eu

# ── Better Auth ──────────────────────────────────────────────────────────
# Public URL of the application (must match Caddy domain)
BETTER_AUTH_URL=https://eurtisan.eu
# Generate with: openssl rand -base64 32 (required in production)
BETTER_AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
# These values must match the db service credentials
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan
POSTGRES_USER=eurtisan
# Change this to a strong random password
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=eurtisan

# Application-level encryption for sensitive database columns (OAuth tokens,
# TOTP secrets, backup codes, Mollie Connect tokens).
# Must be a 256-bit base64-encoded value. Generate with: openssl rand -base64 32
DATABASE_ENCRYPTION_KEY=

# Database pool sizing — tune per environment based on expected concurrency
# and PostgreSQL max_connections (default 100). With multiple app replicas,
# divide max_connections by replica count and leave headroom for migrations.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Meilisearch ──────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
# Master key — server-side ONLY. Never expose to the browser.
MEILISEARCH_API_KEY=change-me-in-production
# Meilisearch container requires this exact variable name
MEILI_MASTER_KEY=change-me-in-production

# Browser-facing search-only key.
# Generate after Meilisearch boots: POST /keys with actions=["search"], indexes=["products"]
VITE_MEILISEARCH_HOST=http://meilisearch:7700
VITE_MEILISEARCH_SEARCH_KEY=change-me-in-production

# Meilisearch background sync tuning.
MEILISEARCH_SYNC_INTERVAL_MS=5000
MEILISEARCH_SYNC_BATCH_SIZE=50

# ── S3-compatible Object Storage (Scaleway in production) ──────────────────
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=eurtisan-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Imgproxy (image resizing and format conversion)
IMGPROXY_BASE_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# Client-facing imgproxy config (Vite prefix required for browser bundle)
VITE_IMGPROXY_BASE_URL=
VITE_S3_BUCKET=eurtisan-uploads

# ── Observability (Grafana Stack — self-hosted) ──────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=production
VITE_APP_VERSION=prod

# Grafana admin password (only used on first boot; change via UI afterward)
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Public Grafana root URL used by the observability stack.
GRAFANA_ROOT_URL=https://eurtisan.eu/grafana

# ── Umami (Cookie-less Analytics) ────────────────────────────────────────
# Optional — leave empty to disable Umami tracking.
# VITE_UMAMI_SCRIPT_URL=
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_HOST_URL=
# Optional SRI integrity hash for the Umami script (generate with openssl dgst -sha384 -binary)
# VITE_UMAMI_SCRIPT_INTEGRITY=sha384-...

# ── Payments ─────────────────────────────────────────────────────────────
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Mollie Connect (seller onboarding and payouts)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Mollie test mode. Must be 'false' in production.
MOLLIE_TEST_MODE=false

# Payout reconciliation job interval (milliseconds). Default: 6 hours.
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000

# Sendcloud reconciliation job interval (milliseconds). Default: 6 hours.
SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000

# ── Sendcloud Shipping ───────────────────────────────────────────────────
# Public key (API username) and secret key (API password) for HTTP Basic Auth.
# Required in production for real labels, rates, and tracking.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

# Optional: separate secret for webhook HMAC verification.
# Defaults to SENDCLOUD_SECRET_KEY when unset.
SENDCLOUD_WEBHOOK_SECRET=

# Optional: explicit Unstamped letter method ID for local dev/staging.
SENDCLOUD_UNSTAMPED_LETTER_METHOD_ID=

# Force Unstamped letter outside production (default true when NODE_ENV != production).
SENDCLOUD_FORCE_UNSTAMPED_LETTER=false

# Number of days to retain Sendcloud webhook event rows before cleanup.
SENDCLOUD_WEBHOOK_RETENTION_DAYS=30

# ── Email (Brevo — EU transactional email) ───────────────────────────────
BREVO_API_KEY=
# Use the dedicated transactional subdomain once it is verified in Brevo.
# See docs/EMAIL_DNS.md for SPF/DKIM/DMARC setup.
EMAIL_FROM_ADDRESS=noreply@mail.eurtisan.eu
EMAIL_FROM_NAME=Eurtisan
# Replies from buyers are routed to support; this can remain on the root domain.
EMAIL_REPLY_TO_ADDRESS=support@eurtisan.eu

# Email SMTP fallback (optional — falls back to Brevo HTTP API when empty)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

# Brevo webhook authentication (production only).
# Configure the Brevo webhook with Bearer auth pointing to:
#   POST /api/webhooks/brevo
#   Authorization: Bearer <BREVO_WEBHOOK_TOKEN>
# Must be at least 64 cryptographically random characters.
BREVO_WEBHOOK_TOKEN=

# Email outbox worker tuning.
EMAIL_OUTBOX_WORKER_INTERVAL_MS=10000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=50
EMAIL_MAX_RETRIES=3

# Auth email rate limits.
EMAIL_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_VERIFICATION_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_SECURITY_ALERT_PER_EMAIL_HOUR=10

# Email retention (days).
EMAIL_SUPPRESSION_SOFT_BOUNCE_RETENTION_DAYS=30
EMAIL_SEND_LOG_RETENTION_DAYS=90

# Request body size limits (bytes)
# Webhook routes use a stricter default to prevent abuse.
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576

# Rate-limit cleanup retention (days)
# Stale rate_limit rows older than this are deleted after each check.
RATE_LIMIT_RETENTION_DAYS=30

# ── Mock mode safeguards ─────────────────────────────────────────────────
# Must be 'false' in production so real money moves through Mollie.
MOCK_PAYMENTS_ENABLED=false
MOCK_PAYOUTS_ENABLED=false

# ── Analytics consent ────────────────────────────────────────────────────
# Required in production; the banner blocks Umami until the user consents.
VITE_ANALYTICS_CONSENT_REQUIRED=true

# ── Grafana access control ───────────────────────────────────────────────
# Space-separated CIDR ranges allowed to reach /grafana. Defaults to 0.0.0.0/32
# (blocks all access) if unset.
GRAFANA_ADMIN_IPS=

# ── Observability wiring ─────────────────────────────────────────────────
# Name of the app container as seen by Docker (used by Alloy log tailing).
APP_CONTAINER_NAME=eurtisan-app

# ── Metrics scrape protection ────────────────────────────────────────────
METRICS_TOKEN=

# ── Health checks ────────────────────────────────────────────────────────
# Filesystem path the readiness probe checks for free space. Use the mount
# point that stores real application data (e.g. /var/lib/postgresql/data for
# the DB volume, or / for the app container root).
HEALTH_DISK_PATH=/

# Minimum free bytes on HEALTH_DISK_PATH for the /api/health/ready probe to
# report healthy. Default: 500 MB.
HEALTH_DISK_THRESHOLD_BYTES=524288000

# ── Backup strategy ──────────────────────────────────────────────────────
# Local backup retention (days). Backups older than this are pruned after a
# successful backup run.
BACKUP_RETENTION_DAYS=30

# Offsite retention (days). Prefer 90 days for production.
BACKUP_OFFSITE_RETENTION_DAYS=90

# rclone remote/path for S3 uploads secondary sync (e.g. "s3:mybucket/uploads").
# Leave empty to skip.
BACKUP_S3_UPLOADS_RCLONE_REMOTE=

# rclone remote name for offsite uploads (e.g. "s3:mybucket/backups").
# Leave empty to skip offsite upload.
BACKUP_OFFSITE_RCLONE_REMOTE=

# ── Alertmanager routing (at least one receiver is required in production) ─
# Use "default" in production; "null" silences alerts in local/dev.
ALERTMANAGER_DEFAULT_RECEIVER=default
# ALERTMANAGER_SMTP_HOST=smtp.example.com
# ALERTMANAGER_SMTP_PORT=587
# ALERTMANAGER_SMTP_FROM=alerts@eurtisan.eu
# ALERTMANAGER_SMTP_TO=ops@eurtisan.eu
# ALERTMANAGER_WEBHOOK_URL=https://hooks.example.com/alerts

# Webhook URL for deploy failure/success alerts (defaults to BACKUP_ALERT_WEBHOOK).
# DEPLOY_ALERT_WEBHOOK=https://hooks.example.com/deploys

# PostgreSQL WAL archiving (enable in production for PITR).
# POSTGRES_WAL_ARCHIVE_ENABLED=false
# POSTGRES_WAL_ARCHIVE_PATH=/opt/eurtisan/backups/wal

# Comma-separated list of origins allowed to send Faro beacons.
ALLOY_FARO_CORS_ORIGINS=https://eurtisan.eu,https://staging.eurtisan.eu

# ── Background-job tuning ────────────────────────────────────────────────
# All cleanup jobs run with sensible defaults; override only when needed.
# SESSION_CLEANUP_INTERVAL_MS=60000
# SESSION_CLEANUP_BATCH_SIZE=100
# CART_CLEANUP_INTERVAL_MS=60000
# CART_CLEANUP_BATCH_SIZE=100
# VERIFICATION_CLEANUP_INTERVAL_MS=60000
# VERIFICATION_CLEANUP_BATCH_SIZE=100
# AUDIT_LOG_CLEANUP_INTERVAL_MS=86400000
# AUDIT_LOG_RETENTION_DAYS=365
# INVENTORY_CLEANUP_INTERVAL_MS=60000
# INVENTORY_CLEANUP_BATCH_SIZE=100
# EMAIL_RETENTION_CLEANUP_INTERVAL_MS=86400000
# EMAIL_RETENTION_CLEANUP_BATCH_SIZE=1000
# EMAIL_SUPPRESSION_CLEANUP_INTERVAL_MS=86400000
# EMAIL_SUPPRESSION_CLEANUP_BATCH_SIZE=1000
# PAYOUT_RECONCILIATION_INTERVAL_MS=21600000
# SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000

# ── Tax / VAT ────────────────────────────────────────────────────────────
# When true, cross-border EU B2B VAT IDs are verified live with the VIES service.
# When false or unset, only offline format checks are performed.
ENABLE_VIES_VALIDATION=false

# When true, the platform charges VAT on platform fees according to EU B2B/B2C rules.
# When false, the platform operates under the French "Franchise en base de TVA" regime.
# Defaults to true for safety.
PLATFORM_VAT_LIABLE=true
