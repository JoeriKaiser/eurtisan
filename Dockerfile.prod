# syntax=docker/dockerfile:1
# Production Dockerfile for Eurtisan
# Multi-stage build: compile with full Bun image, run with slim

# ── Builder ──────────────────────────────────────────────────────────────
FROM oven/bun:1 AS builder
WORKDIR /app

# Install dependencies first (cache layer)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy source and build
COPY . .
RUN bun run build
# Bundle the staging seed into a standalone file (resolves all imports at build time)
RUN bun build src/db/seed-staging.ts --outfile=seed-staging.bundle.mjs --target=bun --external=pg --external=@faker-js/faker --external=meilisearch --external=drizzle-orm

# ── Runtime ──────────────────────────────────────────────────────────────
FROM oven/bun:1-slim
WORKDIR /app

# Install curl for Docker healthchecks
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built application from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/drizzle.config.ts ./
COPY --from=builder /app/drizzle ./drizzle

# Include source tree so server-side scripts (seed, jobs) can be run
# with `bun run`. TypeScript only — no secrets live here.
COPY --from=builder /app/src ./src

# Pre-bundle the staging seed as a standalone JS file that only needs
# node_modules at runtime (no source imports to resolve).
COPY --from=builder /app/seed-staging.bundle.mjs ./seed-staging.bundle.mjs

ENV NODE_ENV=production
EXPOSE 3000

# Copy the custom server entry that wraps the TanStack Start handler
# with static file serving and an HTTP listener.
# Must be placed in dist/server/ alongside server.js for correct path resolution.
COPY server-entry.mjs ./dist/server/server-entry.mjs

CMD ["node", "--import", "./dist/server/instrument.server.mjs", "./dist/server/server-entry.mjs"]
