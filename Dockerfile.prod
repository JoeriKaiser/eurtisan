# syntax=docker/dockerfile:1
# Production Dockerfile for Eurtisan
# Multi-stage build: compile with full Bun image, run with slim
#
# Image Pinning Policy:
# All base images are pinned to an immutable SHA256 digest to ensure
# reproducible builds and prevent supply-chain drift from floating tags.
# When upgrading an image, update both the tag and the digest:
#   docker buildx imagetools inspect <image>:<tag> --format '{{.Manifest.Digest}}'

# ── Builder ──────────────────────────────────────────────────────────────
# Pinned digest for oven/bun:1.3.13
FROM oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS dependencies
WORKDIR /app

# Install dependencies first (cache layer).
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/home/bun/.bun/install/cache \
    bun install --frozen-lockfile

FROM dependencies AS builder

# Browser-visible values are immutable build inputs. They are deliberately
# separate from server runtime secrets and are not inherited by the final stage.
ARG PUBLIC_ANALYTICS_CONSENT_REQUIRED
ARG PUBLIC_APP_ENV
ARG PUBLIC_APP_VERSION
ARG PUBLIC_FARO_COLLECTOR_URL
ARG PUBLIC_FARO_ENABLED
ARG PUBLIC_FARO_APP_NAME
ARG PUBLIC_FARO_SAMPLE_RATE
ARG PUBLIC_IMGPROXY_BASE_URL
ARG PUBLIC_MEILISEARCH_HOST
ARG PUBLIC_MEILISEARCH_VALUE
ARG PUBLIC_SITE_URL
ARG PUBLIC_S3_BUCKET
ARG PUBLIC_UMAMI_ENABLED
ARG PUBLIC_UMAMI_HOST_URL
ARG PUBLIC_UMAMI_SCRIPT_INTEGRITY
ARG PUBLIC_UMAMI_SCRIPT_URL
ARG PUBLIC_UMAMI_WEBSITE_ID

# Copy source and build. VITE_* values exist only for this build process.
COPY . .
RUN EURTISAN_PUBLIC_ENV_ONLY=true \
    VITE_ANALYTICS_CONSENT_REQUIRED="$PUBLIC_ANALYTICS_CONSENT_REQUIRED" \
    VITE_APP_ENV="$PUBLIC_APP_ENV" \
    VITE_APP_VERSION="$PUBLIC_APP_VERSION" \
    VITE_FARO_COLLECTOR_URL="$PUBLIC_FARO_COLLECTOR_URL" \
    VITE_FARO_ENABLED="$PUBLIC_FARO_ENABLED" \
    VITE_FARO_APP_NAME="$PUBLIC_FARO_APP_NAME" \
    VITE_FARO_SAMPLE_RATE="$PUBLIC_FARO_SAMPLE_RATE" \
    VITE_IMGPROXY_BASE_URL="$PUBLIC_IMGPROXY_BASE_URL" \
    VITE_MEILISEARCH_HOST="$PUBLIC_MEILISEARCH_HOST" \
    VITE_MEILISEARCH_SEARCH_KEY="$PUBLIC_MEILISEARCH_VALUE" \
    VITE_PUBLIC_URL="$PUBLIC_SITE_URL" \
    VITE_S3_BUCKET="$PUBLIC_S3_BUCKET" \
    VITE_UMAMI_ENABLED="$PUBLIC_UMAMI_ENABLED" \
    VITE_UMAMI_HOST_URL="$PUBLIC_UMAMI_HOST_URL" \
    VITE_UMAMI_SCRIPT_INTEGRITY="$PUBLIC_UMAMI_SCRIPT_INTEGRITY" \
    VITE_UMAMI_SCRIPT_URL="$PUBLIC_UMAMI_SCRIPT_URL" \
    VITE_UMAMI_WEBSITE_ID="$PUBLIC_UMAMI_WEBSITE_ID" \
    bun run build \
    && bun run bundle:check

# Build production dependencies independently from application source. Source or
# public-version changes must not invalidate the large runtime node_modules layer.
FROM oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS production-dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/home/bun/.bun/install/cache \
    bun install --production --frozen-lockfile

# ── Runtime ──────────────────────────────────────────────────────────────
# Pinned digest for oven/bun:1.3.13-slim
FROM oven/bun:1.3.13-slim@sha256:7e8ed3961db1cdedf17d516dda87948cfedbd294f53bf16462e5b57ed3fff0f1
ARG PUBLIC_APP_VERSION
WORKDIR /app

# Install curl for Docker healthchecks
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy stable dependencies before volatile build artifacts so every release-version
# change does not force Docker to recopy the large node_modules tree. Set ownership
# while copying instead of running an I/O-heavy recursive chown afterward.
COPY --from=production-dependencies --chown=bun:bun /app/package.json ./
COPY --from=production-dependencies --chown=bun:bun /app/node_modules ./node_modules
COPY --from=builder --chown=bun:bun /app/dist ./dist
COPY --from=builder --chown=bun:bun /app/drizzle.config.ts ./
COPY --from=builder --chown=bun:bun /app/drizzle ./drizzle

# Include source tree so server-side scripts (seed, jobs) can be run
# with `bun run`. TypeScript only — no secrets live here.
COPY --from=builder --chown=bun:bun /app/src ./src
COPY --from=builder --chown=bun:bun /app/scripts ./scripts
COPY --from=builder --chown=bun:bun /app/tsconfig.json ./tsconfig.json

LABEL app=eurtisan \
      org.opencontainers.image.revision="$PUBLIC_APP_VERSION" \
      org.opencontainers.image.source="https://github.com/JoeriKaiser/eurtisan"

ENV NODE_ENV=production
EXPOSE 3000

# Copy the custom server entry that wraps the TanStack Start handler
# with static file serving and an HTTP listener.
# Must be placed in dist/server/ alongside server.js for correct path resolution.
COPY --chown=bun:bun server-entry.mjs ./dist/server/server-entry.mjs

# Run as non-root user for security. The oven/bun image provides UID 1000 (bun).
USER bun

CMD ["bun", "--import", "./dist/server/instrument.server.mjs", "./dist/server/server-entry.mjs"]
