# Eurtisan staging environment contract
# Copy to .env on the staging host. Populate blank values outside version control.

NODE_ENV=production
APP_ENV=staging
PUBLIC_URL=https://staging.eurtisan.eu
BETTER_AUTH_URL=https://staging.eurtisan.eu
IMAGE_TAG=

BETTER_AUTH_SECRET=
DATABASE_URL=
POSTGRES_USER=eurtisan
POSTGRES_PASSWORD=
POSTGRES_DB=eurtisan
DATABASE_ENCRYPTION_KEY=
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

MEILISEARCH_ENABLED=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=
MEILI_MASTER_KEY=
MEILISEARCH_SYNC_INTERVAL_MS=5000
MEILISEARCH_SYNC_BATCH_SIZE=50

S3_STORAGE_ENABLED=true
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_PUBLIC_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=eurtisan-staging-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMGPROXY_ENABLED=true
IMGPROXY_BASE_URL=https://staging.eurtisan.eu/uploads
IMGPROXY_HEALTH_URL=http://imgproxy:8080/health
IMGPROXY_KEY=
IMGPROXY_SALT=

# Immutable browser-visible build contract. Changes require an image rebuild.
VITE_PUBLIC_URL=https://staging.eurtisan.eu
VITE_IMGPROXY_BASE_URL=https://staging.eurtisan.eu/uploads
VITE_S3_BUCKET=eurtisan-staging-uploads
VITE_MEILISEARCH_HOST=https://staging.eurtisan.eu/meilisearch
VITE_MEILISEARCH_SEARCH_KEY=
VITE_FARO_ENABLED=true
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_FARO_SAMPLE_RATE=1
VITE_APP_ENV=staging
VITE_APP_VERSION=
VITE_ANALYTICS_CONSENT_REQUIRED=true
VITE_UMAMI_ENABLED=false
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=
VITE_UMAMI_SCRIPT_INTEGRITY=

# Staging uses real provider sandboxes/test modes; application mocks remain forbidden.
MOLLIE_PAYMENTS_ENABLED=true
MOLLIE_CONNECT_ENABLED=true
MOLLIE_API_KEY=
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_TEST_MODE=true
MOCK_PAYMENTS_ENABLED=false
MOCK_PAYOUTS_ENABLED=false
MOLLIE_PAYMENT_RECONCILIATION_INTERVAL_MS=120000
MOLLIE_PAYMENT_RECONCILIATION_MIN_AGE_MS=60000
MOLLIE_PAYMENT_RECONCILIATION_BATCH_SIZE=100
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000
PAYOUT_RECONCILIATION_LOG_RETENTION_DAYS=90
FINANCIAL_TOTALS_RECONCILIATION_INTERVAL_MS=21600000
FINANCIAL_TOTALS_RECONCILIATION_BATCH_SIZE=500

SENDCLOUD_ENABLED=true
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=
SENDCLOUD_FORCE_UNSTAMPED_LETTER=true
SENDCLOUD_UNSTAMPED_LETTER_METHOD_ID=
SENDCLOUD_WEBHOOK_RETENTION_DAYS=30
SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000

# Mailpit is the only staging delivery provider; Compose also enforces this override.
EMAIL_DELIVERY_PROVIDER=smtp
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=noreply@staging.eurtisan.eu
EMAIL_REPLY_TO_ADDRESS=support@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan staging
EMAIL_OUTBOX_WORKER_INTERVAL_MS=10000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=50
EMAIL_MAX_RETRIES=3
EMAIL_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_VERIFICATION_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_SECURITY_ALERT_PER_EMAIL_HOUR=10
EMAIL_SUPPRESSION_SOFT_BOUNCE_RETENTION_DAYS=30
EMAIL_SEND_LOG_RETENTION_DAYS=30

ENABLE_VIES_VALIDATION=false
PLATFORM_VAT_LIABLE=true
FARO_ENABLED=true
UMAMI_ENABLED=false

METRICS_TOKEN=
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576
RATE_LIMIT_RETENTION_DAYS=30
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD_BYTES=524288000
GRAFANA_ADMIN_IPS=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://staging.eurtisan.eu/grafana
APP_CONTAINER_NAME=eurtisan-app-staging
ALLOY_FARO_CORS_ORIGINS=https://staging.eurtisan.eu

SESSION_CLEANUP_INTERVAL_MS=60000
SESSION_CLEANUP_BATCH_SIZE=100
CART_CLEANUP_INTERVAL_MS=60000
CART_CLEANUP_BATCH_SIZE=100
VERIFICATION_CLEANUP_INTERVAL_MS=60000
VERIFICATION_CLEANUP_BATCH_SIZE=100
AUDIT_LOG_CLEANUP_INTERVAL_MS=86400000
AUDIT_LOG_RETENTION_DAYS=90
INVENTORY_CLEANUP_INTERVAL_MS=60000
INVENTORY_CLEANUP_BATCH_SIZE=100
EMAIL_RETENTION_CLEANUP_INTERVAL_MS=86400000
EMAIL_RETENTION_CLEANUP_BATCH_SIZE=1000
EMAIL_SUPPRESSION_CLEANUP_INTERVAL_MS=86400000
EMAIL_SUPPRESSION_CLEANUP_BATCH_SIZE=1000
PAYOUT_RECONCILIATION_LOG_CLEANUP_INTERVAL_MS=86400000
PAYOUT_RECONCILIATION_LOG_CLEANUP_BATCH_SIZE=1000
SENDCLOUD_WEBHOOK_CLEANUP_INTERVAL_MS=86400000
SENDCLOUD_WEBHOOK_CLEANUP_BATCH_SIZE=1000
