# Eurtisan Staging Environment Variables
# Copy this file to .env on the staging VPS and fill in all secrets.
# NEVER commit the real .env file to Git.
#
# This template is used for the Coolify-based staging deployment
# (docker-compose.staging.yml). For Ansible-managed deployments,
# the .env file is generated from infrastructure/ansible/roles/eurtisan/templates/.env.j2

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=production
PUBLIC_URL=https://staging.eurtisan.eu

# ── Better Auth ──────────────────────────────────────────────────────────
BETTER_AUTH_URL=https://staging.eurtisan.eu
# Required in production/staging. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan
POSTGRES_USER=eurtisan
POSTGRES_PASSWORD=change-me-in-staging
POSTGRES_DB=eurtisan

# ── Meilisearch ──────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=change-me-in-staging
MEILI_MASTER_KEY=change-me-in-staging

# Browser-facing search-only key (generate in Meilisearch after boot)
VITE_MEILISEARCH_HOST=http://meilisearch:7700
VITE_MEILISEARCH_SEARCH_KEY=

# ── Object Storage ───────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Imgproxy ─────────────────────────────────────────────────────────────
IMGPROXY_BASE_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Mollie Payments ──────────────────────────────────────────────────────
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
# Set to 'true' explicitly for staging mock-payment testing
MOCK_PAYMENTS_ENABLED=

# Mollie Connect (seller onboarding and payouts)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Mollie test mode. Set to 'true' for sandbox testing in staging.
MOLLIE_TEST_MODE=true

# Mock payouts (no external Mollie Routes API calls).
MOCK_PAYOUTS_ENABLED=false

# Payout reconciliation job interval (milliseconds). Default: 6 hours.
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000

# Sendcloud reconciliation job interval (milliseconds). Default: 6 hours.
SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000

# ── Sendcloud Shipping ───────────────────────────────────────────────────
# Public key (API username) and secret key (API password) for HTTP Basic Auth.
# Same keys are used across environments. In staging labels are forced to
# Unstamped letter so no paid carrier labels are created.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

# Optional: separate secret for webhook HMAC verification.
SENDCLOUD_WEBHOOK_SECRET=

# Optional: explicit Unstamped letter method ID.
SENDCLOUD_UNSTAMPED_LETTER_METHOD_ID=

# Force Unstamped letter in staging (default true when NODE_ENV != production).
SENDCLOUD_FORCE_UNSTAMPED_LETTER=

# ── Email (Brevo) ────────────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan

# ── Observability ────────────────────────────────────────────────────────
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_APP_ENV=staging
VITE_APP_VERSION=staging

# ── Request Body Limits ──────────────────────────────────────────────────
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576

# ── Rate Limit Cleanup ───────────────────────────────────────────────────
RATE_LIMIT_RETENTION_DAYS=30

# ── Umami (Cookie-less Analytics) ────────────────────────────────────────
# Optional — leave empty to disable Umami tracking.
# VITE_UMAMI_SCRIPT_URL=
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_HOST_URL=


# ── Mock mode safeguards ─────────────────────────────────────────────────
# Keep 'false' unless you are explicitly testing mock flows.
MOCK_PAYMENTS_ENABLED=
MOCK_PAYOUTS_ENABLED=false

# ── Analytics consent ────────────────────────────────────────────────────
# Defaults to 'true' in production; set explicitly in staging to match policy.
VITE_ANALYTICS_CONSENT_REQUIRED=true

# ── Grafana access control ───────────────────────────────────────────────
# Space-separated CIDR ranges allowed to reach /grafana. Defaults to 0.0.0.0/32
# (blocks all access) if unset.
GRAFANA_ADMIN_IPS=

# ── Observability wiring ─────────────────────────────────────────────────
# Name of the app container as seen by Docker (used by Alloy log tailing).
APP_CONTAINER_NAME=eurtisan-app-staging

# Optional bearer token for GET /api/metrics (recommended in shared environments).
METRICS_TOKEN=

# ── Health checks ────────────────────────────────────────────────────────
# Filesystem path the readiness probe checks for free space.
HEALTH_DISK_PATH=/

# Minimum free bytes on HEALTH_DISK_PATH for the /api/health/ready probe to
# report healthy. Default: 500 MB.
HEALTH_DISK_THRESHOLD_BYTES=524288000

# ── Background-job tuning ────────────────────────────────────────────────
# All cleanup jobs run with sensible defaults; override only when needed.
# SESSION_CLEANUP_INTERVAL_MS=60000
# CART_CLEANUP_INTERVAL_MS=60000
# VERIFICATION_CLEANUP_INTERVAL_MS=60000
# AUDIT_LOG_CLEANUP_INTERVAL_MS=86400000
# AUDIT_LOG_RETENTION_DAYS=365
# INVENTORY_CLEANUP_INTERVAL_MS=60000
# PAYOUT_RECONCILIATION_INTERVAL_MS=21600000
# SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000
