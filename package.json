{
  "name": "eurtisan",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000 --host\"",
    "build": "vite build && mkdir -p dist/server && cp instrument.server.mjs dist/server/instrument.server.mjs && cp server-entry.mjs dist/server/server-entry.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "bun --import ./dist/server/instrument.server.mjs ./dist/server/server-entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "bun run src/db/seed.ts",
    "db:staging-seed": "bun run src/db/seed-staging.ts",
    "job:inventory-cleanup": "bun run src/jobs/inventory-cleanup.ts",
    "job:session-cleanup": "bun run src/jobs/session-cleanup.ts",
    "job:cart-cleanup": "bun run src/jobs/cart-cleanup.ts",
    "job:meilisearch-sync": "bun run src/jobs/meilisearch-sync.ts",
    "job:audit-log-cleanup": "bun run src/jobs/audit-log-cleanup.ts",
    "job:sendcloud-reconciliation": "bun run src/jobs/sendcloud-reconciliation.ts",
    "job:payout-reconciliation": "bun run src/jobs/payout-reconciliation.ts",
    "job:email-outbox-worker": "bun run src/jobs/email-outbox-worker.ts",
    "job:email-suppression-cleanup": "bun run src/jobs/email-suppression-cleanup.ts",
    "job:email-retention-cleanup": "bun run src/jobs/email-retention-cleanup.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint --write --unsafe ./src",
    "format": "biome format --write ./src",
    "check": "bun tsc --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie preferredLanguage baseLocale --emit-ts-declarations --output-structure locale-modules"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@grafana/faro-react": "^1.12.0",
    "@grafana/faro-web-sdk": "^1.12.0",
    "@grafana/faro-web-tracing": "^1.12.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "better-auth": "^1.6.13",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "meilisearch": "^0.58.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@faker-js/faker": "^10.4.0",
    "@inlang/paraglide-js": "^2.18.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "@playwright/test": "^1.52.0",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10"
  },
  "overrides": {
    "ws": "^8.20.1",
    "esbuild": "^0.25.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ]
}