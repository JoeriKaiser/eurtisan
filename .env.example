# Observability (Grafana Stack — self-hosted)
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan

# App metadata (used by Faro environment tag)
VITE_APP_ENV=development
VITE_APP_VERSION=dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the application (required for SSR, emails, and absolute links)
PUBLIC_URL=http://localhost:3000

# Database (local PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan

# E2E tests (isolated DB — see docker-compose db-test service)
E2E_DATABASE_URL=postgresql://eurtisan:eurtisan@db-test:5432/eurtisan_test

# Database pool sizing — tune per environment based on expected concurrency
# and PostgreSQL max_connections (default 100). With multiple app replicas,
# divide max_connections by replica count and leave headroom for migrations.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Meilisearch (server-side — master key, NEVER expose to browser)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilisearch-api-key

# Meilisearch (browser-facing — search-only API key)
# Generate this in Meilisearch after boot: POST /keys with actions=["search"], indexes=["products"]
# This key is intentionally restricted and safe to expose in the client bundle.
VITE_MEILISEARCH_HOST=http://localhost:7700
VITE_MEILISEARCH_SEARCH_KEY=meilisearch-search-key

# S3-compatible Object Storage (Garage in dev, Scaleway in production)
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=eurtisan-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Imgproxy (image resizing and format conversion)
IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# Client-facing imgproxy config (Vite prefix required for browser bundle)
VITE_IMGPROXY_BASE_URL=http://localhost:8080
VITE_S3_BUCKET=eurtisan-uploads

# Mollie Payments
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
MOCK_PAYMENTS_ENABLED=

# Mollie Connect (seller onboarding and payouts)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Mollie test mode. Set to 'true' to use Mollie's test environment.
# Defaults to 'true' in development, 'false' in production.
MOLLIE_TEST_MODE=true

# Mock payouts (no external Mollie Routes API calls).
# Useful for local development when MOLLIE_API_KEY is not set.
MOCK_PAYOUTS_ENABLED=false

# Payout reconciliation job interval (milliseconds). Default: 6 hours.
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000

# Mondial Relay Shipping
MONDIAL_RELAY_API_KEY=

# Email (Brevo — EU transactional email)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=support@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan

# Email (SMTP — local development via mailpit)
# Set EMAIL_SMTP_HOST to route emails through a local SMTP relay (e.g. mailpit)
# instead of Brevo. When unset the Brevo HTTP API is used.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=1025

# Request body size limits (bytes)
# Webhook routes use a stricter default to prevent abuse.
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576

# Rate-limit cleanup retention (days)
# Stale rate_limit rows older than this are deleted after each check.
RATE_LIMIT_RETENTION_DAYS=30

# Umami (cookie-less analytics)
# VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-id
# VITE_UMAMI_HOST_URL=https://analytics.example.com
# Optional SRI integrity hash for the Umami script (generate with openssl dgst -sha384 -binary)
# VITE_UMAMI_SCRIPT_INTEGRITY=sha384-...

# Optional bearer token for GET /api/metrics (Prometheus scrape)
METRICS_TOKEN=
