# Observability (Grafana Stack — self-hosted)
FARO_ENABLED=true
VITE_FARO_ENABLED=true
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan
VITE_FARO_SAMPLE_RATE=1

# App metadata (browser-visible values are embedded during the build)
VITE_PUBLIC_URL=http://localhost:3000
VITE_APP_ENV=development
VITE_APP_VERSION=dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the application (required for SSR, emails, and absolute links)
PUBLIC_URL=http://localhost:3000

# Database (local PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan

# Application-level encryption for sensitive database columns (OAuth tokens,
# TOTP secrets, backup codes, Mollie Connect tokens).
# Must be a 256-bit base64-encoded value. Generate with: openssl rand -base64 32
# Required in production. Dev/test fall back to a deterministic key if unset.
DATABASE_ENCRYPTION_KEY=

# E2E tests (isolated DB — see docker-compose db-test service)
E2E_DATABASE_URL=postgresql://eurtisan:eurtisan@db-test:5432/eurtisan_test

# Database pool sizing — tune per environment based on expected concurrency
# and PostgreSQL max_connections (100 upstream default; the Compose db services
# set 200). docker-compose.prod/staging.yml pin explicit per-service-class
# values (app 10, background jobs 4), so this value is the fallback outside
# those overrides. With multiple app replicas, divide max_connections by
# replica count and leave headroom for migrations.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Meilisearch (server-side — master key, NEVER expose to browser)
MEILISEARCH_ENABLED=true
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilisearch-api-key
# Master key the Meilisearch container boots with. Must be at least 16 bytes:
# staging and production run with MEILI_ENV=production, which enforces that
# minimum and exits on boot if the key is shorter.
MEILI_MASTER_KEY=meilisearch-master-key-change-me

# S3-compatible Object Storage (Garage in dev, Scaleway in production)
S3_STORAGE_ENABLED=true
S3_ENDPOINT=http://garage:3900
# Public endpoint for browser-facing S3 operations (presigned URLs, public reads).
# In dev, this is localhost because the browser can't resolve the internal Docker hostname.
# In production, set to the same as S3_ENDPOINT (or your CDN URL).
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=eurtisan-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Imgproxy (image resizing and format conversion)
IMGPROXY_ENABLED=true
IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=
# Optional health URL for the readiness probe. Defaults to http://imgproxy:8080/health.
# Set to an empty string to skip the imgproxy dependency check.
IMGPROXY_HEALTH_URL=

# Client-facing imgproxy config (Vite prefix required for browser bundle)
VITE_IMGPROXY_BASE_URL=http://localhost:8080
VITE_S3_BUCKET=eurtisan-uploads

# Mollie Payments
MOLLIE_PAYMENTS_ENABLED=true
MOLLIE_CONNECT_ENABLED=true
# Classic payment webhooks are authenticated by retrieving the payment via this API key.
MOLLIE_API_KEY=
MOCK_PAYMENTS_ENABLED=

# Missed-webhook reconciliation tuning.
MOLLIE_PAYMENT_RECONCILIATION_INTERVAL_MS=120000
MOLLIE_PAYMENT_RECONCILIATION_MIN_AGE_MS=60000
MOLLIE_PAYMENT_RECONCILIATION_BATCH_SIZE=100

# Mollie Connect (seller onboarding and payouts)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# Mollie test mode. Set to 'true' to use Mollie's test environment.
# Defaults to 'true' in development, 'false' in production.
MOLLIE_TEST_MODE=true

# Mock payouts (no external Mollie Routes API calls).
# Useful for local development when MOLLIE_API_KEY is not set.
MOCK_PAYOUTS_ENABLED=false

# Payout reconciliation job interval (milliseconds). Default: 6 hours.
PAYOUT_RECONCILIATION_INTERVAL_MS=21600000

# Read-only financial invariant scan. Default cadence: 6 hours; batch: 500 records.
FINANCIAL_TOTALS_RECONCILIATION_INTERVAL_MS=21600000
FINANCIAL_TOTALS_RECONCILIATION_BATCH_SIZE=500

# Sendcloud reconciliation job interval (milliseconds). Default: 6 hours.
SENDCLOUD_RECONCILIATION_INTERVAL_MS=21600000

# Sendcloud Shipping
SENDCLOUD_ENABLED=true
# Public key (API username) and secret key (API password) for HTTP Basic Auth.
# Required in production for real labels, rates, and tracking.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

# Optional: separate secret for webhook HMAC verification.
# Defaults to SENDCLOUD_SECRET_KEY when unset.
SENDCLOUD_WEBHOOK_SECRET=

# Optional: explicit Unstamped letter method ID for dev/staging.
# If unset, the provider discovers it at runtime via GET /shipping_methods.
SENDCLOUD_UNSTAMPED_LETTER_METHOD_ID=

# Optional: force all label creation to Unstamped letter outside production.
# Defaults to 'true' when NODE_ENV is not 'production'.
SENDCLOUD_FORCE_UNSTAMPED_LETTER=

# Number of days to retain Sendcloud webhook event rows before cleanup.
# Defaults to 30, minimum 1.
SENDCLOUD_WEBHOOK_RETENTION_DAYS=30

# Email (Brevo — EU transactional email)
EMAIL_DELIVERY_PROVIDER=smtp
BREVO_API_KEY=
# Production should use the dedicated transactional subdomain once verified:
# EMAIL_FROM_ADDRESS=noreply@mail.eurtisan.eu
# See docs/EMAIL_DNS.md for SPF/DKIM/DMARC setup.
EMAIL_FROM_ADDRESS=support@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan
# Replies from buyers are routed to support; this can remain on the root domain.
EMAIL_REPLY_TO_ADDRESS=support@eurtisan.eu

# Brevo webhook authentication (production only).
# Configure the Brevo webhook with Bearer auth pointing to:
#   POST /api/webhooks/brevo
#   Authorization: Bearer <BREVO_WEBHOOK_TOKEN>
# Must be at least 64 cryptographically random characters in production.
BREVO_WEBHOOK_TOKEN=

# Email (SMTP — local development via mailpit)
# Set EMAIL_SMTP_HOST to route emails through a local SMTP relay (e.g. mailpit)
# instead of Brevo. When unset the Brevo HTTP API is used.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=1025

# Email outbox worker tuning.
EMAIL_OUTBOX_WORKER_INTERVAL_MS=10000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=50
EMAIL_MAX_RETRIES=3

# Completed-UTC-day seller digest. The job uses the previous day's events only.
NOTIFICATION_DIGEST_INTERVAL_MS=3600000
NOTIFICATION_DIGEST_RECIPIENT_BATCH_SIZE=100

# Auth email rate limits.
EMAIL_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_VERIFICATION_PER_EMAIL_DAY=5
EMAIL_RATE_LIMIT_SECURITY_ALERT_PER_EMAIL_HOUR=10

# Email retention (days).
EMAIL_SUPPRESSION_SOFT_BOUNCE_RETENTION_DAYS=30
EMAIL_SEND_LOG_RETENTION_DAYS=90

# Request body size limits (bytes)
# Webhook routes use a stricter default to prevent abuse.
MAX_BODY_SIZE=10485760
MAX_BODY_SIZE_WEBHOOKS=1048576

# Rate-limit cleanup retention (days)
# Stale rate_limit rows older than this are deleted after each check.
RATE_LIMIT_RETENTION_DAYS=30

# Umami (cookie-less analytics)
UMAMI_ENABLED=false
VITE_UMAMI_ENABLED=false
# VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-id
# VITE_UMAMI_HOST_URL=https://analytics.example.com
# Optional SRI integrity hash for the Umami script (generate with openssl dgst -sha384 -binary)
# VITE_UMAMI_SCRIPT_INTEGRITY=sha384-...

# Analytics consent banner. Set to 'false' to disable the banner in development.
# Defaults to 'true' in production and 'false' in development.
VITE_ANALYTICS_CONSENT_REQUIRED=false

# Grafana admin IP allow-list (Caddy). Space-separated CIDR ranges.
# Defaults to 0.0.0.0/32 (blocks all access) if unset.
GRAFANA_ADMIN_IPS=

# Public Grafana root URL used by the observability stack.
GRAFANA_ROOT_URL=https://eurtisan.eu/grafana

# Name of the app container as seen by Docker (used by Alloy log tailing).
APP_CONTAINER_NAME=eurtisan-app

# Bearer token for GET /api/metrics and background-job metrics endpoints
# (job containers serve :3001; override with METRICS_PORT)
METRICS_TOKEN=

# Health-check disk path (mount point to check for free space)
HEALTH_DISK_PATH=/

# Minimum free bytes on HEALTH_DISK_PATH for the /api/health/ready probe to
# report healthy. Default: 500 MB.
HEALTH_DISK_THRESHOLD_BYTES=524288000

# Bearer token accepted by /api/backup-report. Scheduled backup configuration,
# repository credentials, and retention live in Ansible's protected backup files,
# not the application environment. Falls back to METRICS_TOKEN when unset.
BACKUP_REPORT_TOKEN=

# Alertmanager routing (at least one receiver is required in production).
# Set ALERTMANAGER_DEFAULT_RECEIVER=default in production; use 'null' in dev.
# ALERTMANAGER_DEFAULT_RECEIVER=default
# ALERTMANAGER_SMTP_HOST=smtp.example.com
# ALERTMANAGER_SMTP_PORT=587
# ALERTMANAGER_SMTP_FROM=alerts@eurtisan.eu
# ALERTMANAGER_SMTP_TO=ops@eurtisan.eu
# ALERTMANAGER_WEBHOOK_URL=https://hooks.example.com/alerts

# Webhook URL for deploy failure/success alerts (defaults to BACKUP_ALERT_WEBHOOK).
# DEPLOY_ALERT_WEBHOOK=https://hooks.example.com/deploys

# Informational runtime flag rendered by Ansible when pgBackRest WAL archiving is active.
# POSTGRES_WAL_ARCHIVE_ENABLED=false

# Comma-separated list of origins allowed to send Faro beacons.
ALLOY_FARO_CORS_ORIGINS=https://eurtisan.eu,https://staging.eurtisan.eu

# Grafana initial admin password (only used on first boot; change via UI afterward).
# Required when the observability stack is started via docker-compose.observability.yml.
GRAFANA_ADMIN_PASSWORD=changeme

# Meilisearch background sync tuning.
MEILISEARCH_SYNC_INTERVAL_MS=5000
MEILISEARCH_SYNC_BATCH_SIZE=50

# Background-job cleanup tuning. All values have sensible defaults.
# SESSION_CLEANUP_INTERVAL_MS=60000
# SESSION_CLEANUP_BATCH_SIZE=100
# CART_CLEANUP_INTERVAL_MS=60000
# CART_CLEANUP_BATCH_SIZE=100
# VERIFICATION_CLEANUP_INTERVAL_MS=60000
# VERIFICATION_CLEANUP_BATCH_SIZE=100
# AUDIT_LOG_CLEANUP_INTERVAL_MS=86400000
# AUDIT_LOG_RETENTION_DAYS=365
# Search telemetry retention. Queries are user-typed free text, so keep this
# aligned with your privacy notice.
# SEARCH_EVENT_CLEANUP_INTERVAL_MS=86400000
# SEARCH_EVENT_RETENTION_DAYS=180
# INVENTORY_CLEANUP_INTERVAL_MS=60000
# INVENTORY_CLEANUP_BATCH_SIZE=100
# EMAIL_RETENTION_CLEANUP_INTERVAL_MS=86400000
# EMAIL_RETENTION_CLEANUP_BATCH_SIZE=1000
# EMAIL_SUPPRESSION_CLEANUP_INTERVAL_MS=86400000
# EMAIL_SUPPRESSION_CLEANUP_BATCH_SIZE=1000
# PAYOUT_RECONCILIATION_LOG_RETENTION_DAYS=365
# PAYOUT_RECONCILIATION_LOG_CLEANUP_INTERVAL_MS=86400000
# PAYOUT_RECONCILIATION_LOG_CLEANUP_BATCH_SIZE=1000

# Tax / VAT
# When true, cross-border EU B2B VAT IDs are verified live with the VIES service.
# When false or unset, only offline format checks are performed.
ENABLE_VIES_VALIDATION=false

# When true, the platform charges VAT on platform fees according to EU B2B/B2C rules.
# When false, the platform operates under the French "Franchise en base de TVA" regime.
# Defaults to true for safety.
PLATFORM_VAT_LIABLE=true

# Operator legal and billing identity (disclosed on legal pages, invoices, and email footers)
OPERATOR_LEGAL_NAME="Eurtisan Platform"
OPERATOR_LEGAL_EMAIL="legal@eurtisan.eu"
OPERATOR_BILLING_EMAIL="billing@eurtisan.eu"
OPERATOR_VAT_ID="FR00000000000"
OPERATOR_STREET="1 Place de la République"
OPERATOR_CITY="Paris"
OPERATOR_POSTAL_CODE="75001"
OPERATOR_COUNTRY="FR"

# French LCEN Art. 6-III imprint identifiers, rendered on /imprint.
# Optional in development/staging; required in production (enforced by
# src/lib/infra/server-environment.server.ts). Placeholder values below —
# replace with the real registration data, never commit real identifiers.
OPERATOR_LEGAL_FORM="SAS"
OPERATOR_SHARE_CAPITAL="10 000 euros"
OPERATOR_SIREN="000000000"
OPERATOR_SIRET="00000000000000"
OPERATOR_RCS_CITY="Paris"
OPERATOR_PUBLICATION_DIRECTOR="First Last"

# Hosting provider disclosed on /imprint (LCEN Art. 6-III 2°). For this
# self-hosted deployment, the VPS provider operating the host.
# Required in production; placeholders below.
HOSTING_PROVIDER_NAME="Example VPS Provider"
HOSTING_PROVIDER_ADDRESS="1 Rue des Exemples, 75002 Paris, France"
HOSTING_PROVIDER_PHONE="+33 1 00 00 00 00"

