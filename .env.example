# Observability (Grafana Stack — self-hosted)
VITE_FARO_COLLECTOR_URL=/collect
VITE_FARO_APP_NAME=eurtisan

# App metadata (used by Faro environment tag)
VITE_APP_ENV=development
VITE_APP_VERSION=dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Database (local PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://eurtisan:eurtisan@db:5432/eurtisan

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilisearch-api-key

# S3-compatible Object Storage (Garage in dev, Scaleway in production)
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=eurtisan-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Imgproxy (image resizing and format conversion)
IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# Mollie Payments
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
MOCK_PAYMENTS_ENABLED=

# Mondial Relay Shipping
MONDIAL_RELAY_API_KEY=

# Email (Brevo — EU transactional email)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@eurtisan.eu
EMAIL_FROM_NAME=Eurtisan

# Email (SMTP — local development via mailpit)
# Set EMAIL_SMTP_HOST to route emails through a local SMTP relay (e.g. mailpit)
# instead of Brevo. When unset the Brevo HTTP API is used.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=1025
